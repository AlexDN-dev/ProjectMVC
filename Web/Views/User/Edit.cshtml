@model Web.Controllers.UserEdit

@{
    ViewBag.Title = "title";
    Layout = "_Layout";
}

<h2 class="text-center">Mode Édition</h2>
<div class="w-100 d-flex justify-content-center align-content-center">
    <form class="w-50" method="post" asp-action="Edit">
        <input type="hidden" asp-for="@Model.User.Id" />
        <div class="mb-3">
            <label asp-for="@Model.User.Lastname" class="form-label">Nom</label>
            <input asp-for="@Model.User.Lastname" class="form-control" id="@Model.User.Lastname"/>
            <span asp-validation-for="@Model.User.Lastname" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="@Model.User.Firstname" class="form-label">Prénom</label>
            <input asp-for="@Model.User.Firstname" class="form-control" id="@Model.User.Firstname"/>
            <span asp-validation-for="@Model.User.Firstname" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="@Model.User.Email" class="form-label">Email</label>
            <input asp-for="@Model.User.Email" class="form-control" id="Email"/>
            <span asp-validation-for="@Model.User.Email" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label class="form-label">Rôles</label>

            @foreach (var role in Model.Roles)
            {
                <div class="form-check">
                    <input class="form-check-input"
                           type="checkbox"
                           name="SelectedRoleIds"
                           value="@role.Id"
                           @(Model.SelectedRoleIds.Contains(role.Id) ? "checked" : "")/>

                    <label class="form-check-label">
                        @role.RoleName
                    </label>
                </div>
            }
        </div>
        <div class="w-100 d-flex justify-content-center align-content-center">
            <button type="submit" class="btn btn-primary">Confirmer</button>
        </div>
    </form>
</div>